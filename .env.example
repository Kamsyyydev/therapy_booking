# Django Secret Key (Generate a random string in production)
SECRET_KEY=django-insecure-therapy-booking-calm-teal-cream-secret-key-2026

# Set to False in production
DEBUG=False

# Comma-separated allowed hostnames (e.g. your-app.onrender.com,yourdomain.com)
ALLOWED_HOSTS=*

# Comma-separated trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.railway.app,https://*.pythonanywhere.com

# Optional PostgreSQL Database URL (Leave commented for SQLite default)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname
